PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smartkrishi
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: seed creates an admin ONLY when both are set. Use a strong unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Live weather is optional; no API key required. Set false for offline sample mode.
LIVE_WEATHER=true
